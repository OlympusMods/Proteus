          { "type": "fill", "x": 330, "w": 8, "color": "#FF000080", "when": "value < 0 && 330 >= start && 330 + 8 <= start + band" },
          { "type": "fill", "x": 340, "w": 8, "color": "#FF000080", "when": "value < 0 && 340 >= start && 340 + 8 <= start + band" },
          { "type": "fill", "x": 350, "w": 8, "color": "#FF000080", "when": "value < 0 && 350 >= start && 350 + 8 <= start + band" },
          { "type": "fill", "x": 360, "w": 8, "color": "#FF000080", "when": "value < 0 && 360 >= start && 360 + 8 <= start + band" },
          { "type": "fill", "x": 370, "w": 8, "color": "#FF000080", "when": "value < 0 && 370 >= start && 370 + 8 <= start + band" },
          { "type": "fill", "x": 380, "w": 8, "color": "#FF000080", "when": "value < 0 && 380 >= start && 380 + 8 <= start + band" },
          { "type": "fill", "x": 390, "w": 8, "color": "#FF000080", "when": "value < 0 && 390 >= start && 390 + 8 <= start + band" }
        ] }
      ]
    },
    "scrollbar": {
      "vars": { "otl": "#FFFFFFFF", "obr": "#FF404040", "itl": "#FFDFDFDF", "ibr": "#FF808080", "face": "#FFC0C0C0" },
      "layers": [
        { "type": "fill", "color": "#FFE0E0E0" },
        { "type": "fill", "x": 0, "y": "thumb_y", "w": "w", "h": "thumb_h", "color": "obr" },
        { "type": "fill", "x": 0, "y": "thumb_y", "w": "w - 1", "h": "thumb_h - 1", "color": "otl" },
        { "type": "fill", "x": 1, "y": "thumb_y + 1", "w": "w - 2", "h": "thumb_h - 2", "color": "ibr" },
        { "type": "fill", "x": 1, "y": "thumb_y + 1", "w": "w - 3", "h": "thumb_h - 3", "color": "itl" },
        { "type": "fill", "x": 2, "y": "thumb_y + 2", "w": "w - 4", "h": "thumb_h - 4", "color": "face" }
      ]
    },
    "tooltip": {
      "layers": [
        { "type": "panel", "radius": 0, "color": "#FFFFFFE1", "border": "#FF000000" }
      ]
    },
    "toast": {
      "vars": { "otl": "#FFFFFFFF", "obr": "#FF404040", "itl": "#FFDFDFDF", "ibr": "#FF808080", "face": "#FFC0C0C0" },
      "layers": [
        { "type": "fill", "x": 0, "y": 0, "w": "w", "h": "h", "color": "obr" },
        { "type": "fill", "x": 0, "y": 0, "w": "w - 1", "h": "h - 1", "color": "otl" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 2", "h": "h - 2", "color": "ibr" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 3", "h": "h - 3", "color": "itl" },
        { "type": "fill", "x": "2 + floor((w - 4) * 0 / 12)", "y": 2, "w": "floor((w - 4) * 1 / 12) - floor((w - 4) * 0 / 12)", "h": "h - 4", "color": "#FF000080" },
        { "type": "fill", "x": "2 + floor((w - 4) * 1 / 12)", "y": 2, "w": "floor((w - 4) * 2 / 12) - floor((w - 4) * 1 / 12)", "h": "h - 4", "color": "#FF010C87" },
        { "type": "fill", "x": "2 + floor((w - 4) * 2 / 12)", "y": 2, "w": "floor((w - 4) * 3 / 12) - floor((w - 4) * 2 / 12)", "h": "h - 4", "color": "#FF03188F" },
        { "type": "fill", "x": "2 + floor((w - 4) * 3 / 12)", "y": 2, "w": "floor((w - 4) * 4 / 12) - floor((w - 4) * 3 / 12)", "h": "h - 4", "color": "#FF042496" },
        { "type": "fill", "x": "2 + floor((w - 4) * 4 / 12)", "y": 2, "w": "floor((w - 4) * 5 / 12) - floor((w - 4) * 4 / 12)", "h": "h - 4", "color": "#FF06309D" },
        { "type": "fill", "x": "2 + floor((w - 4) * 5 / 12)", "y": 2, "w": "floor((w - 4) * 6 / 12) - floor((w - 4) * 5 / 12)", "h": "h - 4", "color": "#FF073CA4" },
        { "type": "fill", "x": "2 + floor((w - 4) * 6 / 12)", "y": 2, "w": "floor((w - 4) * 7 / 12) - floor((w - 4) * 6 / 12)", "h": "h - 4", "color": "#FF0948AC" },
        { "type": "fill", "x": "2 + floor((w - 4) * 7 / 12)", "y": 2, "w": "floor((w - 4) * 8 / 12) - floor((w - 4) * 7 / 12)", "h": "h - 4", "color": "#FF0A54B3" },
        { "type": "fill", "x": "2 + floor((w - 4) * 8 / 12)", "y": 2, "w": "floor((w - 4) * 9 / 12) - floor((w - 4) * 8 / 12)", "h": "h - 4", "color": "#FF0C60BA" },
        { "type": "fill", "x": "2 + floor((w - 4) * 9 / 12)", "y": 2, "w": "floor((w - 4) * 10 / 12) - floor((w - 4) * 9 / 12)", "h": "h - 4", "color": "#FF0D6CC1" },
        { "type": "fill", "x": "2 + floor((w - 4) * 10 / 12)", "y": 2, "w": "floor((w - 4) * 11 / 12) - floor((w - 4) * 10 / 12)", "h": "h - 4", "color": "#FF0F78C9" },
        { "type": "fill", "x": "2 + floor((w - 4) * 11 / 12)", "y": 2, "w": "floor((w - 4) * 12 / 12) - floor((w - 4) * 11 / 12)", "h": "h - 4", "color": "#FF1084D0" }
      ]
    },
    "effect": {
      "vars": {
        "otl": "#FFFFFFFF", "obr": "#FF404040", "itl": "#FFDFDFDF", "ibr": "#FF808080",
        "tone": "if(harmful > 0.5, effect_bad, effect_good)",
        "face": "mix(#FFC0C0C0, tone, warn * 0.45)"
      },
      "layers": [
        { "type": "fill", "x": 0, "y": 0, "w": "w", "h": "h", "color": "obr" },
        { "type": "fill", "x": 0, "y": 0, "w": "w - 1", "h": "h - 1", "color": "otl" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 2", "h": "h - 2", "color": "ibr" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 3", "h": "h - 3", "color": "itl" },
        { "type": "fill", "x": 2, "y": 2, "w": "w - 4", "h": "h - 4", "color": "face" },
        { "type": "fill", "x": 3, "y": "h - 5", "w": "w - 6", "h": 2, "color": "tone", "when": "ambient < 0.5" }
      ]
    },
    "chat_line": { "layers": [ { "type": "fill", "color": "alpha(#FF000040, 0.72 * opacity)" } ] },
    "chat_input": {
      "vars": { "otl": "#FF808080", "obr": "#FFFFFFFF", "itl": "#FF404040", "ibr": "#FFDFDFDF", "face": "#FF000040" },
      "layers": [
        { "type": "fill", "x": 0, "y": 0, "w": "w", "h": "h", "color": "obr" },
        { "type": "fill", "x": 0, "y": 0, "w": "w - 1", "h": "h - 1", "color": "otl" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 2", "h": "h - 2", "color": "ibr" },
        { "type": "fill", "x": 1, "y": 1, "w": "w - 3", "h": "h - 3", "color": "itl" },
        { "type": "fill", "x": 2, "y": 2, "w": "w - 4", "h": "h - 4", "color": "face" }
      ]
    },
    "chat_scroll": {
      "layers": [
        { "type": "fill", "color": "alpha(if(fresh > 0.5, #FF9EA8D8, #FFC0C0C0), opacity)" },
        { "type": "fill", "w": 1, "color": "alpha(#FFFFFFFF, opacity)" }
      ]
    },
    "swatch": {
      "layers": [
        { "type": "fill", "x": -2, "y": -2, "w": "w + 4", "h": "h + 4", "color": "#FF000080", "when": "selected > 0.5" },
        { "type": "panel", "radius": 0, "color": "color", "border": "if(selected > 0.5, #FFFFFFFF, #FF404040)" }
      ]
    }
  }
}
